{
  "name": "agent-cloud-video",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Remotion launch video for Agent Cloud, built on the app's own screen components.",
  "scripts": {
    "studio": "remotion studio",
    "still": "remotion still",
    "render": "remotion render Launch out/launch.mp4 --codec=h264 --crf=18",
    "render:square": "remotion render LaunchSquare out/launch-square.mp4 --codec=h264 --crf=18",
    "render:hero": "remotion render HeroLoop out/hero-loop.mp4 --codec=h264 --crf=18",
    "render:draft": "remotion render Launch out/draft.mp4 --codec=h264 --scale=0.5 --crf=28",
    "audit": "node scripts/audit-stills.mjs"
  },
  "dependencies": {
    "@remotion/animation-utils": "4.0.506",
    "@remotion/cli": "4.0.506",
    "@remotion/fonts": "4.0.506",
    "@remotion/layout-utils": "4.0.506",
    "@remotion/tailwind-v4": "4.0.506",
    "@remotion/transitions": "4.0.506",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.506",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "typescript": "^5.8.3"
  }
}
